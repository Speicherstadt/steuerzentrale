          "dateien": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pfad": {
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^\\/.*"
                },
                "inhalt": {
                  "type": "string",
                  "minLength": 1
