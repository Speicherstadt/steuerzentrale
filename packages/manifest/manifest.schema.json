                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      },
                      "pfad": {
                        "type": "string",
                        "format": "starts_with",
                        "pattern": "^\\/.*"
                      }
                    },
                    "required": ["name", "pfad"],
                    "additionalProperties": false
                  }
                },
                "dateien": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pfad": {
                        "type": "string",
                        "format": "starts_with",
                        "pattern": "^\\/.*"
                      },
                      "inhalt": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["pfad", "inhalt"],
                    "additionalProperties": false
                  }
                },
                "argv": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  }
                },
                "feste_env": {
                  "default": {},
