          "architektur": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["amd64", "arm64"]
            }
          },
          "ram_mb": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "standard": {
            "default": false,
            "type": "boolean"
