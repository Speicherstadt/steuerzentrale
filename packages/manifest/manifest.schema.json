        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "image": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9-]+)+(?::[0-9]+)?|[a-z0-9][a-z0-9-]*:[0-9]+|localhost)(\\/[a-z0-9._-]+)+@sha256:[0-9a-f]{64}$"
              },
              {
                "type": "object",
                "properties": {
                  "noch_nicht_veroeffentlicht": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["noch_nicht_veroeffentlicht"],
                "additionalProperties": false
