                      },
                      "required": ["noch_nicht_veroeffentlicht"],
                      "additionalProperties": false
                    }
                  ]
                },
                "architektur": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["amd64", "arm64"]
                  }
                },
                "braucht": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
