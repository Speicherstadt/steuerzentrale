# haben 0.12.0-rc.1 for the installation haben-k1, rendered by the Steuerzentrale; do not edit

[Unit]
Description=haben 0.12.0-rc.1, db (haben-k1)

[Container]
ContainerName=haben-k1-db
Image=ghcr.io/speicherstadt/haben-db@sha256:ae2974f327c44afba08208dd51f61096ecdf76a49e7e4776e0ba1d8c4e00caf7
Network=haben-k1.network:alias=db
Label="de.speicherstadt.steuerzentrale.installation=haben-k1"
Label="de.speicherstadt.steuerzentrale.kunde=kunde-1"
Label="de.speicherstadt.steuerzentrale.app=haben"
Label="de.speicherstadt.steuerzentrale.version=0.12.0-rc.1"
NoNewPrivileges=true
Volume=haben-k1-db.volume:/var/lib/postgresql/data
Environment="POSTGRES_USER=haben"
Environment="POSTGRES_DB=haben"
Secret=haben-k1-postgres-password,type=env,target=POSTGRES_PASSWORD

[Service]
Slice=haben-k1.slice
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
