# haben 0.12.0-rc.1 for the installation haben-k1, rendered by the Steuerzentrale; do not edit

[Unit]
Description=haben 0.12.0-rc.1, app (haben-k1)
Requires=haben-k1-db.service
After=haben-k1-db.service

[Container]
ContainerName=haben-k1-app
Image=ghcr.io/speicherstadt/haben@sha256:61f712f54383d185855984a0c4b856c6907a006e104ba800c66ed1ed3d260014
Network=haben-k1.network:alias=app
Label="de.speicherstadt.steuerzentrale.installation=haben-k1"
Label="de.speicherstadt.steuerzentrale.kunde=kunde-1"
Label="de.speicherstadt.steuerzentrale.app=haben"
Label="de.speicherstadt.steuerzentrale.version=0.12.0-rc.1"
NoNewPrivileges=true
PublishPort=127.0.0.1:20001:3000
Volume=haben-k1-belege.volume:/var/lib/haben/belege
Volume=haben-k1-eric-log.volume:/var/lib/haben/eric-log
Volume=haben-k1-eric.volume:/var/lib/haben/eric
Secret=haben-k1-database-url,type=env,target=DATABASE_URL
Environment="BETTER_AUTH_URL=https://haben-k1.kunde.example"
Secret=haben-k1-better-auth-secret,type=env,target=BETTER_AUTH_SECRET
Secret=haben-k1-haben-encryption-key,type=env,target=HABEN_ENCRYPTION_KEY
Environment="ELSTER_HERSTELLER_ID=test-elster_hersteller_id"
Environment="ERIC_AUTO_INSTALL=test-eric_auto_install"
Environment="FINTS_PRODUKT_ID=test-fints_produkt_id"
Secret=haben-k1-anthropic-api-key,type=env,target=ANTHROPIC_API_KEY
Environment="OIDC_ONLY=false"
Environment="OIDC_ISSUER=test-oidc-oidc_issuer"
Environment="OIDC_CLIENT_ID=test-oidc-oidc_client_id"
Secret=haben-k1-oidc-client-secret,type=env,target=OIDC_CLIENT_SECRET
Environment="OIDC_GROUP_INHABER=test-oidc_group_inhaber"
Environment="OIDC_GROUP_STEUERBERATUNG=test-oidc_group_steuerberatung"

[Service]
Slice=haben-k1.slice
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
