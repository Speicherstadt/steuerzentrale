# belegt 0.0.7 for the installation belegt-k1, rendered by the Steuerzentrale; do not edit

[Unit]
Description=belegt 0.0.7, app (belegt-k1)
Requires=belegt-k1-db.service
After=belegt-k1-db.service

[Container]
ContainerName=belegt-k1-app
Image=ghcr.io/speicherstadt/belegt@sha256:0aa5bcf46b6551ab9e0a6918f8e41868bc0e7074aa73c6e897a91e9a4d13603c
Network=belegt-k1.network:alias=app
Label="de.speicherstadt.steuerzentrale.installation=belegt-k1"
Label="de.speicherstadt.steuerzentrale.kunde=kunde-1"
Label="de.speicherstadt.steuerzentrale.app=belegt"
Label="de.speicherstadt.steuerzentrale.version=0.0.7"
NoNewPrivileges=true
PublishPort=127.0.0.1:20001:3000
Volume=belegt-k1-daten.volume:/var/lib/belegt
Secret=belegt-k1-database-url,type=env,target=DATABASE_URL
Environment="BETTER_AUTH_URL=https://belegt-k1.kunde.example"
Secret=belegt-k1-better-auth-secret,type=env,target=BETTER_AUTH_SECRET
Secret=belegt-k1-belegt-schluessel,type=env,target=BELEGT_SCHLUESSEL
Environment="OIDC_ISSUER=test-oidc-oidc_issuer"
Environment="OIDC_CLIENT_ID=test-oidc-oidc_client_id"
Secret=belegt-k1-oidc-client-secret,type=env,target=OIDC_CLIENT_SECRET

[Service]
Slice=belegt-k1.slice
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
