{
  "@id": "beispiel-k1",
  "match": [
    {
      "host": [
        "beispiel-k1.kunde.example"
      ]
    }
  ],
  "handle": [
    {
      "handler": "request_body",
      "max_size": 1048576
    },
    {
      "handler": "reverse_proxy",
      "upstreams": [
        {
          "dial": "127.0.0.1:20001"
        }
      ],
      "transport": {
        "protocol": "http",
        "response_header_timeout": "30s"
      },
      "headers": {
        "request": {
          "set": {
            "X-Forwarded-For": [
              "{http.request.remote.host}"
            ]
          },
          "delete": [
            "Forwarded",
            "X-Real-IP"
          ]
        }
      }
    }
  ],
  "terminal": true
}
