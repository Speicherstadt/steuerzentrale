{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../node_modules/.tsbuild/scripts",
    "rootDir": "..",
    "types": ["bun"]
  },
  // the test of agent and Zentrale together (apps/agent/test/zentrale.test.ts) reads both apps
  "references": [
    { "path": "../packages/protokoll" },
    { "path": "../packages/manifest" },
    { "path": "../apps/zentrale" },
    { "path": "../apps/agent" }
  ],
  "include": [
    "*.ts",
    "pr-regeln/*.ts",
    "../vitest.config.ts",
    "../vitest.agent.config.ts",
    "../vitest.solid-diagnostics.ts",
    "../apps/agent/test/*.ts",
    "../manifeste/beispiel/app/*.ts"
  ]
}
