{
  "name": "steuerzentrale",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run i18n",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./packages/ui/src/paraglide --strategy localStorage preferredLanguage baseLocale --silent",
    "typecheck": "bun run i18n && tsc -b",
    "lint": "biome check --error-on-warnings . && bun scripts/check-dependencies.ts && bun scripts/solid-muster.ts",
    "format": "biome check --write .",
    "test": "bun --bun vitest run",
    "test:agent": "bun --bun vitest run --config vitest.agent.config.ts",
    "build": "bun scripts/build-all.ts",
    "e2e": "playwright test --trace off",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "dev:zentrale": "STEUERZENTRALE_PORT=18300 STEUERZENTRALE_DATA=data/dev STEUERZENTRALE_URL=http://localhost:5181 bun run --cwd apps/zentrale dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:demo": "VITE_OHNE_ANMELDUNG=1 bun run --cwd apps/web dev --mode demo",
    "db:generate": "bun run --cwd apps/zentrale drizzle-kit generate && bun scripts/migrationen.ts",
    "manifest:schema": "bun scripts/manifest-schema.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@playwright/test": "1.65.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@steuerzentrale/manifest": "workspace:*",
    "@steuerzentrale/protokoll": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "fast-check": "4.10.3",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
