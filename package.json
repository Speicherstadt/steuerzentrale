{
  "name": "steuerzentrale",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome check --error-on-warnings . && bun scripts/check-dependencies.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "build": "bun scripts/build-all.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
